# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore en wordt nooit gecommit.

# --- PostgreSQL ---
POSTGRES_DB=anna_remembers
POSTGRES_USER=anna
POSTGRES_PASSWORD=verander_mij

# --- LLM Provider ---
# Opties: ollama | anthropic
LLM_PROVIDER=ollama

# OpenRouter (aanbevolen — één account, toegang tot Claude/GPT/Gemini/Llama)
# API key aanmaken via https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Anthropic direct (alternatief — API key via https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (lokaal)
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3

# --- Escalatie (Laag 1 — lokaal via Ollama) ---
# Pull eenmalig: docker exec -it anna_remembers-ollama-1 ollama pull qwen2.5:0.5b
ESCALATION_MODEL=qwen2.5:0.5b
# Minuten tussen escalaties per patiënt; zet op 0 om cooldown uit te zetten (testen)
ESCALATION_COOLDOWN_MINUTES=1

# --- TTS ---
PIPER_URL=http://piper-http-bridge:5000
XTTS_URL=http://xtts-bridge:5000
VOICE_DIR=/voice

# --- Twilio SMS (escalatienotificaties) ---
# Account SID en Auth Token via console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio-nummer dat je in de console hebt geactiveerd
TWILIO_FROM=+15551234567
# Mobiel nummer dat je als "Verified Caller ID" hebt toegevoegd
NOTIFICATION_PHONE=+31612345678

# --- Docker Hub ---
# Alleen nodig als je lokaal images wil pushen.
# In CI/CD worden deze waarden via GitHub Secrets ingesteld.
DOCKERHUB_USERNAME=jouw-gebruikersnaam
DOCKERHUB_TOKEN=dckr_pat_...

# Portkey LLM gateway
PORTKEY_API_KEY=pk-...
PORTKEY_MODEL=gpt-4.1
PORTKEY_CONFIG=

# Escalation guardrail (Laag 1)
# provider opties: ollama | openai_compat | portkey
# - ollama: lokaal model (zie ESCALATION_MODEL hierboven)
# - openai_compat: directe OpenAI-compatible API (bv. DeepSeek met eigen key)
# - portkey: via de Portkey gateway naar een gedeployed catalog-model,
#   bv. @azure-openai/gpt-5.4-nano (snel + goedkoop, gebruikt PORTKEY_API_KEY)
ESCALATION_PROVIDER=portkey
# Voor portkey: ESCALATION_MODEL=@azure-openai/gpt-5.4-nano
ESCALATION_PORTKEY_CONFIG=
# Alleen voor openai_compat:
ESCALATION_API_KEY=
ESCALATION_BASE_URL=https://api.deepseek.com/v1

# Embeddings
# Voor EMBEDDING_PROVIDER=portkey: gebruik de Portkey model-catalog slug
# @azure-openai/<model> als OPENAI_EMBEDDING_MODEL. Die adresseert de Azure-integratie
# direct en omzeilt de default LLM-config (die anders een chat-model forceert dat niet
# kan embedden). PORTKEY_EMBEDDING_CONFIG alleen nodig bij een aparte dashboard-config.
EMBEDDING_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=@azure-openai/text-embedding-3-large
PORTKEY_EMBEDDING_CONFIG=
